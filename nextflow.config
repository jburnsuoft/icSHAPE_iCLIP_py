params {
    // Protein name for identification
    pname = 'protein_name'
    // Folder containing in vitro icSHAPE files
    vitroShapeFolder = '/path/to/vitroShapeFolder'
    // Folder containing in vivo icSHAPE files
    vivoShapeFolder = '/path/to/vivoShapeFolder'
    // Folder containing RNAplFold files
    plFolder = '/path/to/plFolder'
    // Folder containing shuffle files
    plshuffle = '/path/to/plshuffle'
}

process {
    // Executor configuration
    executor = 'local'
    cpus = 2
    memory = '4 GB'
}
